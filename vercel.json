{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bianalytic.net" }],
      "destination": "https://www.bianalytic.net/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://picsum.photos https://fastly.picsum.photos https://www.transparenttextures.com https://www.google-analytics.com; frame-src https://pos.bianalytic.tr; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/hakkimizda", "destination": "/hakkimizda/index.html" },
    { "source": "/rehber/kobiler-icin-hizli-veri-analizi", "destination": "/rehber/kobiler-icin-hizli-veri-analizi/index.html" },
    { "source": "/rehber/kobiler-icin-hazir-paneller", "destination": "/rehber/kobiler-icin-hazir-paneller/index.html" },
    { "source": "/rehber/satis-ve-gelir-takibi", "destination": "/rehber/satis-ve-gelir-takibi/index.html" },
    { "source": "/rehber/kobiler-icin-is-zekasi-secimi", "destination": "/rehber/kobiler-icin-is-zekasi-secimi/index.html" },
    { "source": "/rehber/48-saatte-is-zekasi-baslangici", "destination": "/rehber/48-saatte-is-zekasi-baslangici/index.html" },
    { "source": "/karsilastirma/is-zekasi-danismanligi-ve-bi-platformu", "destination": "/karsilastirma/is-zekasi-danismanligi-ve-bi-platformu/index.html" },
    { "source": "/iletisim", "destination": "/iletisim/index.html" },
    { "source": "/kullanim-kosullari", "destination": "/kullanim-kosullari/index.html" },
    { "source": "/gizlilik-politikasi", "destination": "/gizlilik-politikasi/index.html" },
    { "source": "/is-zekasi-danismanligi", "destination": "/is-zekasi-danismanligi/index.html" },
    { "source": "/ozel-yapay-zeka", "destination": "/ozel-yapay-zeka/index.html" },
    { "source": "/restoran", "destination": "/restoran/index.html" },
    { "source": "/suru", "destination": "/suru/index.html" }
  ]
}
